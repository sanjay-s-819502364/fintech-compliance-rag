# AWS credentials are resolved via the standard boto3 credential chain
# (environment variables, ~/.aws/credentials, or an IAM role) — nothing
# is hardcoded in this project. Set your AWS region below.

AWS_REGION=us-east-1

# Bedrock Agent / Knowledge Base identifiers (create your own via the
# AWS Bedrock console, then fill these in)
BEDROCK_AGENT_ID=
BEDROCK_KNOWLEDGE_BASE_ID=
